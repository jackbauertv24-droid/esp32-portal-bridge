CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ESP32-S3R8: 8 MB octal PSRAM in package
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Internal RAM is scarce (Wi-Fi radio, DMA, camera): allow task stacks in PSRAM
# for tasks that never touch flash, and keep Wi-Fi code out of internal RAM
# (about 25-30 KB more heap, slightly lower peak Wi-Fi speed).
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Fewer pre-allocated Wi-Fi buffers (each 1.6 KB of internal RAM; was 16 + 16)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# The mDNS task never touches flash, so its stack can be in PSRAM
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
# Task list with stack use in reports
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Router: NAT from the hotspot to Wi-Fi or 4G (PPP over USB)
CONFIG_LWIP_IP_FORWARD=y
# mDNS name for the admin page on the hotspot only, never on the venue network.
CONFIG_MDNS_PREDEF_NETIF_STA=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=10
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=11520

# Admin web server and the portal mirror
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=n

# TLS: the certificate bundle is used for forwarding (Telegram, webhook, MQTT,
# GitHub). Skipping verification is possible only where no CA is given, which
# the firmware does just for portals when the "verify portal TLS" setting is off.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# Crash dumps go to flash so the next diagnostics report can include them
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_SPIFFS_MAX_PARTITIONS=1
